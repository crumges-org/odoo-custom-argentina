<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_arca_import_line_tree" model="ir.ui.view">
        <field name="name">l10n_ar.arca.import.line.tree</field>
        <field name="model">l10n_ar.arca.import.line</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" editable="bottom" decoration-danger="status == 'error'" decoration-muted="not is_refund and status == 'exists'" decoration-warning="is_refund and status in ('ready', 'exists')" decoration-success="not is_refund and status == 'ready'">
                <field name="status" column_invisible="True"/>
                <field name="is_refund" column_invisible="True"/>
                <field name="to_import" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="date" readonly="1"/>
                <!-- Remove doc type to save space, redundant with preview -->
                <!-- <field name="document_type_name" readonly="1"/> -->
                <!-- Remove cuit, use partner -->
                <field name="cuit" readonly="1" optional="hide"/>
                <field name="partner_name" readonly="1" string="Nombre Origen" optional="hide"/>
                <field name="partner_id" widget="many2one_avatar" string="Contacto"/>
                <field name="preview_desc" readonly="1" string="Documento"/>
                <field name="amount_total" readonly="1" string="Total"/>
                <field name="error_desc" readonly="1" widget="html" string="Notas / Errores"/>
                <button name="action_toggle_import" type="object" string="Excluir" icon="fa-times" invisible="status != 'ready' or not to_import" class="btn-danger"/>
                <button name="action_toggle_import" type="object" string="Incluir" icon="fa-check" invisible="status != 'ready' or to_import" class="btn-success"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_ar_arca_import_line_form" model="ir.ui.view">
        <field name="name">l10n_ar.arca.import.line.form</field>
        <field name="model">l10n_ar.arca.import.line</field>
        <field name="arch" type="xml">
            <form string="Detalle de Línea" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="document_type_name" readonly="1"/>
                            <field name="point_of_sale" readonly="1"/>
                            <field name="number" readonly="1"/>
                            <field name="cuit" readonly="1"/>
                            <field name="afip_auth_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_name" readonly="1"/>
                            <field name="is_refund" invisible="1"/>
                            <field name="amount_total" readonly="1" decoration-danger="is_refund"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="preview_desc" readonly="1"/>
                            <field name="move_id" readonly="1" options="{'no_create': True}" invisible="not move_id" decoration-danger="1" widget="many2one_button"/>
                        </group>
                    </group>
                    <group>
                        <field name="status" readonly="1" widget="badge" decoration-danger="status == 'error'" decoration-muted="status == 'exists'" decoration-success="status == 'ready'"/>
                        <field name="error_desc" readonly="1" invisible="status != 'error'"/>
                        <field name="invoice_values" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
